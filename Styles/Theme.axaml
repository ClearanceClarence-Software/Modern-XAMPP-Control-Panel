<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FB7A24" />
        <SolidColorBrush x:Key="PageBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E0E3E8" />
        <SolidColorBrush x:Key="RowLineBrush" Color="#EEF0F3" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2329" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5D6470" />
        <SolidColorBrush x:Key="FaintBrush" Color="#8A909A" />

        <!-- Line icons on a 24-unit grid, drawn with Path.icon -->
        <StreamGeometry x:Key="IconStack">M12,3 L3,8 L12,13 L21,8 Z M3,13 L12,18 L21,13</StreamGeometry>
        <StreamGeometry x:Key="IconGear">M12,9 A3,3 0 1 1 11.99,9 Z M12,2 L12,5 M12,19 L12,22 M4.2,4.2 L6.3,6.3 M17.7,17.7 L19.8,19.8 M2,12 L5,12 M19,12 L22,12 M4.2,19.8 L6.3,17.7 M17.7,6.3 L19.8,4.2</StreamGeometry>
        <StreamGeometry x:Key="IconGlobe">M12,3 A9,9 0 1 1 11.99,3 Z M3,12 L21,12 M12,3 C16,7 16,17 12,21 M12,3 C8,7 8,17 12,21</StreamGeometry>
        <StreamGeometry x:Key="IconShell">M5,4 L19,4 A2,2 0 0 1 21,6 L21,18 A2,2 0 0 1 19,20 L5,20 A2,2 0 0 1 3,18 L3,6 A2,2 0 0 1 5,4 Z M7,9 L10,12 L7,15 M13,15 L17,15</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z</StreamGeometry>
        <StreamGeometry x:Key="IconServices">M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M8,4.5 L8,7.5 M15,10.5 L15,13.5 M10,16.5 L10,19.5</StreamGeometry>
        <StreamGeometry x:Key="IconHelp">M12,3 A9,9 0 1 1 11.99,3 Z M9.5,9.5 A2.5,2.5 0 1 1 13,11.8 C12.4,12.1 12,12.7 12,13.4 L12,14 M12,17 L12,17.01</StreamGeometry>
        <StreamGeometry x:Key="IconUpdate">M12,16 L12,4 M7,9 L12,4 L17,9 M5,20 L19,20</StreamGeometry>
        <StreamGeometry x:Key="IconQuit">M15,4 L18,4 A2,2 0 0 1 20,6 L20,18 A2,2 0 0 1 18,20 L15,20 M10,17 L5,12 L10,7 M5,12 L16,12</StreamGeometry>
    </Styles.Resources>

    <Style Selector=":is(Window)">
        <Setter Property="Background" Value="{StaticResource PageBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.colhead">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Log text: mono font, size inherited from the log's font-size option -->
    <Style Selector="TextBlock.logtext">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
    </Style>

    <Style Selector="SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Path.icon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- Status dot: hollow when stopped, green when running, amber while busy -->
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="#9AA1AB" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.running">
        <Setter Property="Fill" Value="#16A34A" />
        <Setter Property="Stroke" Value="#16A34A" />
    </Style>
    <Style Selector="Ellipse.dot.busy">
        <Setter Property="Fill" Value="#F59E0B" />
        <Setter Property="Stroke" Value="#F59E0B" />
    </Style>

    <!-- Row action buttons -->
    <Style Selector="Button.tool">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D5D9DF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F1F3F6" />
        <Setter Property="BorderBrush" Value="#C3C8D0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E7EAEE" />
    </Style>

    <Style Selector="Button.tool.start">
        <Setter Property="Width" Value="84" />
        <Setter Property="Background" Value="#EEFAF2" />
        <Setter Property="BorderBrush" Value="#C9E6D2" />
        <Setter Property="Foreground" Value="#15803D" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tool.start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#DDF3E4" />
        <Setter Property="BorderBrush" Value="#A9D8B8" />
        <Setter Property="Foreground" Value="#15803D" />
    </Style>

    <Style Selector="Button.tool.stop">
        <Setter Property="Width" Value="84" />
        <Setter Property="Background" Value="#FDF0F0" />
        <Setter Property="BorderBrush" Value="#F1C6C6" />
        <Setter Property="Foreground" Value="#B42318" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tool.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FBE1E1" />
        <Setter Property="BorderBrush" Value="#E9A9A9" />
        <Setter Property="Foreground" Value="#B42318" />
    </Style>

    <!-- Right-hand column buttons -->
    <Style Selector="Button.side">
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D5D9DF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.side:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F1F3F6" />
        <Setter Property="BorderBrush" Value="#C3C8D0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.side:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E7EAEE" />
    </Style>

    <!-- Accent button (dialogs) -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E8691A" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Compact log rows -->
    <Style Selector="ListBox.log ListBoxItem">
        <Setter Property="Padding" Value="14,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</Styles>
