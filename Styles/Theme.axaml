            <StreamGeometry x:Key="IconFolder">M3.5 7.5A2 2 0 0 1 5.5 5.5H9.2A2 2 0 0 1 10.7 6.2L12 7.7H18.5A2 2 0 0 1 20.5 9.7V16.5A2 2 0 0 1 18.5 18.5H5.5A2 2 0 0 1 3.5 16.5ZM3.5 11H20.5</StreamGeometry>
            <StreamGeometry x:Key="IconFolderTint">M3.5 11H20.5V16.5A2 2 0 0 1 18.5 18.5H5.5A2 2 0 0 1 3.5 16.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconServices">M3.5 7H12.4M17.6 7H20.5M3.5 12H6.4M11.6 12H20.5M3.5 17H13.4M18.6 17H20.5M12.4 7A2.6 2.6 0 1 0 17.6 7A2.6 2.6 0 1 0 12.4 7ZM6.4 12A2.6 2.6 0 1 0 11.6 12A2.6 2.6 0 1 0 6.4 12ZM13.4 17A2.6 2.6 0 1 0 18.6 17A2.6 2.6 0 1 0 13.4 17Z</StreamGeometry>
            <StreamGeometry x:Key="IconServicesTint">M12.4 7A2.6 2.6 0 1 0 17.6 7A2.6 2.6 0 1 0 12.4 7ZM6.4 12A2.6 2.6 0 1 0 11.6 12A2.6 2.6 0 1 0 6.4 12ZM13.4 17A2.6 2.6 0 1 0 18.6 17A2.6 2.6 0 1 0 13.4 17Z</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M9.0 3.5H15.0A5.5 5.5 0 0 1 20.5 9.0V15.0A5.5 5.5 0 0 1 15.0 20.5H9.0A5.5 5.5 0 0 1 3.5 15.0V9.0A5.5 5.5 0 0 1 9.0 3.5ZM12 11.2V16.4M12 7.8H12.01</StreamGeometry>
            <StreamGeometry x:Key="IconInfoTint">M9.0 3.5H15.0A5.5 5.5 0 0 1 20.5 9.0V15.0A5.5 5.5 0 0 1 15.0 20.5H9.0A5.5 5.5 0 0 1 3.5 15.0V9.0A5.5 5.5 0 0 1 9.0 3.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconHelp">M3.5 12A8.5 8.5 0 1 0 20.5 12A8.5 8.5 0 1 0 3.5 12ZM8.6 12A3.4 3.4 0 1 0 15.4 12A3.4 3.4 0 1 0 8.6 12ZM9.6 9.6L5.99 5.99M14.4 9.6L18.01 5.99M14.4 14.4L18.01 18.01M9.6 14.4L5.99 18.01</StreamGeometry>
            <StreamGeometry x:Key="IconHelpTint">M3.5 12A8.5 8.5 0 1 0 20.5 12A8.5 8.5 0 1 0 3.5 12Z</StreamGeometry>
            <StreamGeometry x:Key="IconUpdate">M12 14.5V3.8M7.6 8.2L12 3.8L16.4 8.2M4 14V17.5A2.5 2.5 0 0 0 6.5 20H17.5A2.5 2.5 0 0 0 20 17.5V14</StreamGeometry>
