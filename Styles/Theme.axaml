            <StreamGeometry x:Key="IconDatabase">M5 6.5A7 3 0 1 0 19 6.5A7 3 0 1 0 5 6.5ZM5 6.5V17.5A7 3 0 0 0 19 17.5V6.5M5 12A7 3 0 0 0 19 12</StreamGeometry>
            <StreamGeometry x:Key="IconDatabaseTint">M5 6.5A7 3 0 1 0 19 6.5A7 3 0 1 0 5 6.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconLogs">M7.0 3.5H17.0A2.5 2.5 0 0 1 19.5 6.0V18.0A2.5 2.5 0 0 1 17.0 20.5H7.0A2.5 2.5 0 0 1 4.5 18.0V6.0A2.5 2.5 0 0 1 7.0 3.5ZM8.2 8H8.209999999999999M8.2 12H8.209999999999999M8.2 16H8.209999999999999M11.5 8H16M11.5 12H16M11.5 16H16</StreamGeometry>
            <StreamGeometry x:Key="IconLogsTint">M7.0 3.5H17.0A2.5 2.5 0 0 1 19.5 6.0V18.0A2.5 2.5 0 0 1 17.0 20.5H7.0A2.5 2.5 0 0 1 4.5 18.0V6.0A2.5 2.5 0 0 1 7.0 3.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconSites">M6.0 4.5H18.0A2.5 2.5 0 0 1 20.5 7.0V17.0A2.5 2.5 0 0 1 18.0 19.5H6.0A2.5 2.5 0 0 1 3.5 17.0V7.0A2.5 2.5 0 0 1 6.0 4.5ZM3.5 9.5H20.5M6.6 7H6.609999999999999M9.2 7H9.209999999999999</StreamGeometry>
            <StreamGeometry x:Key="IconSitesTint">M6 4.5H18A2.5 2.5 0 0 1 20.5 7V9.5H3.5V7A2.5 2.5 0 0 1 6 4.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconCode">M8.5 7.5L4 12L8.5 16.5M15.5 7.5L20 12L15.5 16.5M13.6 5L10.4 19</StreamGeometry>
            <StreamGeometry x:Key="IconSun">M8.3 12A3.7 3.7 0 1 0 15.7 12A3.7 3.7 0 1 0 8.3 12ZM18.3 12.0L20.6 12.0M16.45 16.45L18.08 18.08M12.0 18.3L12.0 20.6M7.55 16.45L5.92 18.08M5.7 12.0L3.4 12.0M7.55 7.55L5.92 5.92M12.0 5.7L12.0 3.4M16.45 7.55L18.08 5.92</StreamGeometry>
            <StreamGeometry x:Key="IconSunTint">M8.3 12A3.7 3.7 0 1 0 15.7 12A3.7 3.7 0 1 0 8.3 12Z</StreamGeometry>
            <StreamGeometry x:Key="IconMoon">M20.2 14.3A8.4 8.4 0 1 1 9.7 3.8A6.6 6.6 0 0 0 20.2 14.3Z</StreamGeometry>
            <StreamGeometry x:Key="IconMoonTint">M20.2 14.3A8.4 8.4 0 1 1 9.7 3.8A6.6 6.6 0 0 0 20.2 14.3Z</StreamGeometry>
            <StreamGeometry x:Key="IconQuit">M12 3.5V11.5M7.2 6.6A8 8 0 1 0 16.8 6.6</StreamGeometry>
            <StreamGeometry x:Key="IconQuitTint">M4 13A8 8 0 1 0 20 13A8 8 0 1 0 4 13Z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector=":is(Window)">
        <Setter Property="Background" Value="{DynamicResource PageBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.colhead">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Log text: mono font, size inherited from the log's font-size option -->
    <Style Selector="TextBlock.logtext">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
    </Style>

    <Style Selector="SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="v|Glyph">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Accent" Value="{DynamicResource AccentBrush}" />
        <!-- Config > "Two-tone icons"; set by AppTheme.ApplyIcons -->
        <Setter Property="IsDuotone" Value="{DynamicResource IconsDuotone}" />
    </Style>

    <!-- Status dot: hollow when stopped, green when running, amber while busy -->
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource DotStoppedBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.running">
        <Setter Property="Fill" Value="{DynamicResource DotRunningBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource DotRunningBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.busy">
        <Setter Property="Fill" Value="{DynamicResource DotBusyBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource DotBusyBrush}" />
    </Style>

    <!-- Row action buttons -->
    <Style Selector="Button.tool">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>

    <Style Selector="Button.tool.start">
        <Setter Property="Width" Value="84" />
        <Setter Property="Background" Value="{DynamicResource StartBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StartBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StartFgBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tool.start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StartHoverBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StartHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StartFgBrush}" />
    </Style>

    <Style Selector="Button.tool.stop">
        <Setter Property="Width" Value="84" />
        <Setter Property="Background" Value="{DynamicResource StopBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StopBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StopFgBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tool.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StopHoverBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StopHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StopFgBrush}" />
    </Style>

    <!-- Icon-only button that blends into the page; a soft background shows on hover -->
    <!-- Text that acts as a link: the update hint on a module row, Start all / Stop all in the header -->
    <Style Selector="Button.textlink">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.textlink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>
    <Style Selector="Button.textlink:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.textlink:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover v|Glyph">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Right-hand column buttons -->
    <Style Selector="Button.side">
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.side:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.side:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>

    <!-- Accent button: the one main action of a dialog or pane. Fluent has an "accent" class of its own that
         paints the button's inner presenter in the Windows accent color (blue), so the colors are set on that
         presenter too; setting them on the button alone loses to Fluent. -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    </Style>

    <!-- Secondary text; listed before the status colors so a status class wins when both are set -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- Status colors for text anywhere: errors, warnings, success and info notes -->
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="TextBlock.ok">
        <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.debug">
        <Setter Property="Foreground" Value="{DynamicResource DebugBrush}" />
    </Style>
    <Style Selector="TextBlock.info">
        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
    </Style>

    <!-- Log source tags: one color per module -->
    <Style Selector="TextBlock.source">
        <Setter Property="Foreground" Value="{DynamicResource SourceOtherBrush}" />
    </Style>
    <Style Selector="TextBlock.source.apache">
        <Setter Property="Foreground" Value="{DynamicResource SourceApacheBrush}" />
    </Style>
    <Style Selector="TextBlock.source.mysql">
        <Setter Property="Foreground" Value="{DynamicResource SourceMySqlBrush}" />
    </Style>
    <Style Selector="TextBlock.source.filezilla">
        <Setter Property="Foreground" Value="{DynamicResource SourceFileZillaBrush}" />
    </Style>
    <Style Selector="TextBlock.source.mercury">
        <Setter Property="Foreground" Value="{DynamicResource SourceMercuryBrush}" />
    </Style>
    <Style Selector="TextBlock.source.tomcat">
        <Setter Property="Foreground" Value="{DynamicResource SourceTomcatBrush}" />
    </Style>
    <Style Selector="TextBlock.source.update">
        <Setter Property="Foreground" Value="{DynamicResource SourceUpdateBrush}" />
    </Style>
    <Style Selector="TextBlock.source.sites">
        <Setter Property="Foreground" Value="{DynamicResource SourceSitesBrush}" />
    </Style>
    <Style Selector="TextBlock.source.php">
        <Setter Property="Foreground" Value="{DynamicResource SourcePhpBrush}" />
    </Style>

    <!-- Compact log rows -->
    <Style Selector="ListBox.log ListBoxItem">
        <Setter Property="Padding" Value="14,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Lists with a detail pane beside them (Netstat, Databases): no boxes, a wash of the accent on the chosen entry -->
    <Style Selector="ListBox.rows">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UpdatePillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UpdatePillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Small gray labels beside a name in those lists -->
    <Style Selector="Border.tag">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Border.tag TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- A field name in a detail pane -->
    <Style Selector="TextBlock.field">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Full-width actions in the detail pane -->
    <Style Selector="Button.wide">
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.end">
        <Setter Property="Foreground" Value="{DynamicResource StopFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StopBorderBrush}" />
    </Style>
    <Style Selector="Button.end:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StopBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StopFgBrush}" />
    </Style>

    <!-- A switch (Netstat's scope, the Logs levels): segments in one track, the chosen one raised -->
    <Style Selector="Button.seg">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.seg.on">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
</Styles>
