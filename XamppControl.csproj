<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>XamppControl</AssemblyName>
    <RootNamespace>XamppControl</RootNamespace>
    <Version>0.1.1</Version>
    <Product>Modern XAMPP Control Panel</Product>
    <Authors>ClearanceClarence</Authors>
    <Company>ClearanceClarence</Company>
    <Copyright>Copyright (c) 2026 ClearanceClarence</Copyright>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- Code rules: see .editorconfig. IDE rules set to warning there also show up in dotnet build. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Exe icon: run tools\Get-XamppIcon.ps1 once to create Assets\xampp.ico from your XAMPP install. -->
  <PropertyGroup Condition="Exists('Assets\xampp.ico')">
    <ApplicationIcon>Assets\xampp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Build date shown in the title bar, like "[ Compiled: Oct 27th 2026 ]". -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::Now.ToString("yyyy-MM-dd"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.14" />
  </ItemGroup>

</Project>
