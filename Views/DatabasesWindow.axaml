<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        xmlns:db="using:XamppControl.Databases"
        x:Class="XamppControl.Views.DatabasesWindow"
        x:DataType="vm:DatabasesViewModel"
        Title="{DynamicResource Common.Databases}"
        Width="760" Height="560" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,8,Auto,8,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{DynamicResource Databases.BackUpADatabaseTo}" />
            <Button Grid.Column="1" Classes="tool" Content="{DynamicResource Databases.ImportSql}" Click="Import_Click" IsEnabled="{Binding IsIdle}" />
            <Button Grid.Column="3" Classes="tool" Content="{DynamicResource Databases.OpenDumpFolder}" Command="{Binding OpenDumpFolderCommand}" />
            <Button Grid.Column="5" Classes="tool" Content="{DynamicResource Common.Refresh}" Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Grid.Row="1" Classes="card">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="34" Padding="12,0" Background="{DynamicResource HeaderBrush}" CornerRadius="8,8,0,0"
                        BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,110,100,Auto">
                        <TextBlock Grid.Column="0" Classes="colhead" Text="{DynamicResource Databases.DATABASE}" />
                        <TextBlock Grid.Column="1" Classes="colhead" Text="{DynamicResource Databases.TABLES}" />
                        <TextBlock Grid.Column="2" Classes="colhead" Text="{DynamicResource Databases.SIZE}" />
                        <TextBlock Grid.Column="3" Classes="colhead" Text="{DynamicResource Common.ACTIONS}" MinWidth="200" />
                    </Grid>
                </Border>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Databases}" IsEnabled="{Binding IsIdle}" Margin="0,0,10,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="db:DatabaseInfo">
                                <Border Padding="12,8" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,110,100,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TableText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Size}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" MinWidth="200">
                                            <Button Classes="tool" Content="{DynamicResource Databases.Export}" Click="Export_Click" />
                                            <Button Classes="tool" Content="{DynamicResource Databases.ImportInto}" Click="ImportInto_Click" />
                                            <Button Classes="tool" Content="{DynamicResource Databases.Drop}" Click="Drop_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{DynamicResource Databases.ImportsRunAsRootA}" />
            <Button Grid.Column="1" Classes="tool" Content="{DynamicResource Common.Close}" Width="90" Click="Close_Click" IsEnabled="{Binding IsIdle}" />
        </Grid>
    </Grid>
</Window>
