<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XamppControl.Views.ServicePortsWindow"
        Title="{DynamicResource ServicePorts.Title}"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="18" Spacing="12">
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                   Text="{DynamicResource ServicePorts.TheseTellTheControlPanel}" />

        <!-- Apache -->
        <Border Classes="card" Padding="16,12">
            <StackPanel>
                <TextBlock Classes="section" Text="Apache" />
                <Grid ColumnDefinitions="2*,12,*,12,*">
                    <StackPanel Grid.Column="0"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.ServiceName}" /><TextBox x:Name="ApacheService" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.MainPort}" /><TextBox x:Name="ApachePort" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.SSLPort}" /><TextBox x:Name="ApacheSslPort" /></StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- MySQL -->
        <Border Classes="card" Padding="16,12">
            <StackPanel>
                <TextBlock Classes="section" Text="MySQL" />
                <Grid ColumnDefinitions="2*,12,*,12,*">
                    <StackPanel Grid.Column="0"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.ServiceName}" /><TextBox x:Name="MySqlService" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.MainPort}" /><TextBox x:Name="MySqlPort" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.RootPassword}" /><TextBox x:Name="MySqlPassword" PasswordChar="•" /></StackPanel>
                </Grid>
                <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource ServicePorts.TheRootPasswordIsOnly}" />
            </StackPanel>
        </Border>

        <!-- FileZilla + Tomcat -->
        <Grid ColumnDefinitions="*,12,*">
            <Border Grid.Column="0" Classes="card" Padding="16,12">
                <StackPanel>
                    <TextBlock Classes="section" Text="FileZilla" />
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.MainPort}" /><TextBox x:Name="FileZillaPort" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.AdminPort}" /><TextBox x:Name="FileZillaAdminPort" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="16,12">
                <StackPanel>
                    <TextBlock Classes="section" Text="Tomcat" />
                    <Grid ColumnDefinitions="*,8,*,8,*">
                        <StackPanel Grid.Column="0"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.Main}" /><TextBox x:Name="TomcatPort" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.Shutdown}" /><TextBox x:Name="TomcatShutdownPort" /></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.AJP}" /><TextBox x:Name="TomcatAjpPort" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Mailpit -->
        <Border Classes="card" Padding="16,12">
            <StackPanel>
                <TextBlock Classes="section" Text="Mailpit" />
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.SMTPPortPHPMailSends}" /><TextBox x:Name="MailpitSmtpPort" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.WebInterfacePort}" /><TextBox x:Name="MailpitHttpPort" /></StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Mercury -->
        <Border Classes="card" Padding="16,12">
            <StackPanel>
                <TextBlock Classes="section" Text="Mercury" />
                <TextBlock Classes="lbl" Text="{DynamicResource ServicePorts.PortsCommaSeparated}" />
                <TextBox x:Name="MercuryPorts" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Classes="error" FontSize="12" IsVisible="False" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Classes="tool" Content="{DynamicResource ServicePorts.Defaults}" Click="Defaults_Click" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="tool" Width="90" Height="34" Content="{DynamicResource Common.Abort}" Click="Abort_Click" />
                <Button Classes="tool" Width="90" Height="34" Content="{DynamicResource Common.Save}" FontWeight="SemiBold" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
