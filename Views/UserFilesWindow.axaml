<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:XamppControl.Core"
        x:Class="XamppControl.Views.UserFilesWindow"
        Title="User Defined Files"
        Width="620" Height="460"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18">
        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                   Text="Extra files to show in a module's Config menu, e.g. a project's .htaccess or a vhost file you edit often." />

        <Border Grid.Row="1" Classes="card">
            <ListBox x:Name="FileList" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:UserFile">
                        <Grid ColumnDefinitions="90,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Module}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Path}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="120,8,*,8,Auto,8,Auto" Margin="0,12,0,0">
            <ComboBox x:Name="ModuleBox" Grid.Column="0" HorizontalAlignment="Stretch" />
            <TextBox x:Name="PathBox" Grid.Column="2" Watermark="File path" />
            <Button Grid.Column="4" Classes="tool" Content="Browse…" Click="Browse_Click" />
            <Button Grid.Column="6" Classes="tool" Content="Add" Click="Add_Click" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Classes="tool" Content="Remove selected" Click="Remove_Click" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="tool" Width="90" Height="34" Content="Abort" Click="Abort_Click" />
                <Button Classes="tool" Width="90" Height="34" Content="Save" FontWeight="SemiBold" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
