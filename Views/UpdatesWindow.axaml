<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        xmlns:up="using:XamppControl.Updates"
        x:Class="XamppControl.Views.UpdatesWindow"
        x:DataType="vm:UpdatesViewModel"
        Title="PHP and MariaDB versions"
        Width="680" Height="820" MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="Border.version">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource RowLineBrush}" />
            <Setter Property="Background" Value="#FAFBFC" />
        </Style>
        <Style Selector="Border.version.active">
            <Setter Property="BorderBrush" Value="#C9E6D2" />
            <Setter Property="Background" Value="#F3FBF5" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="VersionRow" x:DataType="up:InstalledVersion">
            <Border Classes="version" Classes.active="{Binding IsActive}" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <Border IsVisible="{Binding IsActive}" Background="#DDF3E4" CornerRadius="4" Padding="6,0">
                                <TextBlock Text="active" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="note" Text="{Binding Detail}" FontFamily="Cascadia Mono, Consolas, Courier New" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding CanSwitch}">
                        <Button Classes="tool" Content="Switch to" Click="Switch_Click" />
                        <Button Classes="tool" Content="Remove" Click="Remove_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto,Auto" Margin="18">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="14" Margin="0,0,6,0">

                <!-- PHP -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PHP" FontSize="16" FontWeight="Bold" />
                        <TextBlock Classes="section" Text="INSTALLED" />
                        <ItemsControl ItemsSource="{Binding PhpVersions}" ItemTemplate="{StaticResource VersionRow}"
                                      IsEnabled="{Binding IsIdle}" />
                        <Button Classes="tool" Content="Add existing folder…" Click="PhpImport_Click"
                                IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" />

                        <TextBlock Classes="section" Text="INSTALL ANOTHER VERSION" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding PhpBranches}" SelectedItem="{Binding SelectedPhp}"
                                  HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" PlaceholderText="Loading branches…" />
                        <TextBlock Text="{Binding PhpAvailable}" FontSize="13" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="Download and install" Click="PhpLatest_Click" IsEnabled="{Binding IsIdle}" />
                            <Button Classes="tool" Content="Install from zip…" Click="PhpZip_Click" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <TextBlock Classes="note"
                                   Text="PHP 8 Thread Safe x64 builds. The new version becomes active and the current one stays installed. php.ini, PEAR and XAMPP's extras are carried over; each version keeps its own php.ini afterwards. Switching restarts Apache and syncs its shared DLLs." />
                    </StackPanel>
                </Border>

                <!-- MariaDB -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MariaDB" FontSize="16" FontWeight="Bold" />
                        <TextBlock Classes="section" Text="INSTALLED" />
                        <ItemsControl ItemsSource="{Binding MariaVersions}" ItemTemplate="{StaticResource VersionRow}"
                                      IsEnabled="{Binding IsIdle}" />
                        <Button Classes="tool" Content="Add existing folder…" Click="MariaImport_Click"
                                IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" />
                        <TextBlock Classes="note"
                                   Text="Each MariaDB version keeps its own databases in its own data folder. Sharing one would break: a newer server converts data files so older ones can't open them. Switching shows that version's databases." />

                        <TextBlock Classes="section" Text="INSTALL ANOTHER VERSION" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding MariaMajors}" SelectedItem="{Binding SelectedMajor}"
                                  HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" PlaceholderText="Loading releases…" />
                        <TextBlock Text="{Binding MariaAvailable}" FontSize="13" TextWrapping="Wrap" />
                        <CheckBox Content="Back up all databases to an SQL dump first (recommended)"
                                  IsChecked="{Binding MakeSqlDump}" IsEnabled="{Binding IsIdle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="Download and install" Click="MariaLatest_Click" IsEnabled="{Binding IsIdle}" />
                            <Button Classes="tool" Content="Install from zip…" Click="MariaZip_Click" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <TextBlock Classes="note"
                                   Text="The new version starts with a copy of the active version's databases (full clean shutdown, copy, mariadb-upgrade). The current version stays installed with its own copy. Only newer versions can take over data; LTS series are supported for years, rolling ones for months." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Progress / result -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
            <ProgressBar IsVisible="{Binding ShowProgress}" IsIndeterminate="{Binding ProgressIndeterminate}"
                         Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" />
            <Button Classes="tool" Content="{Binding RollbackLabel}" IsVisible="{Binding CanRollback}"
                    IsEnabled="{Binding IsIdle}" Click="Rollback_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Classes="tool" Content="Check again" Click="Check_Click" IsEnabled="{Binding IsIdle}" />
            <TextBlock Grid.Column="1" Classes="note" Text="Details are written to the panel's log." VerticalAlignment="Center" Margin="12,0" />
            <Button Grid.Column="2" Classes="tool" Content="Close" Width="90" Click="Close_Click" IsEnabled="{Binding IsIdle}" />
        </Grid>
    </Grid>
</Window>
