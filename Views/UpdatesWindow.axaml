<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        xmlns:up="using:XamppControl.Updates"
        x:Class="XamppControl.Views.UpdatesWindow"
        x:DataType="vm:UpdatesViewModel"
        Title="{DynamicResource Common.Versions}"
        Width="680" Height="820" MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="Border.version">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource RowLineBrush}" />
            <Setter Property="Background" Value="{DynamicResource VersionBrush}" />
        </Style>
        <Style Selector="Border.version.active">
            <Setter Property="BorderBrush" Value="{DynamicResource VersionActiveBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource VersionActiveBrush}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="VersionRow" x:DataType="up:InstalledVersion">
            <Border Classes="version" Classes.active="{Binding IsActive}" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <Border IsVisible="{Binding IsActive}" Background="{DynamicResource ActivePillBrush}" CornerRadius="4" Padding="6,0">
                                <TextBlock Text="{DynamicResource Updates.Active}" FontSize="11" Foreground="{DynamicResource ActivePillTextBrush}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <!-- A leftover of an update: a newer build of the same branch is installed -->
                            <Border IsVisible="{Binding IsReplaced}" Background="{DynamicResource UpdatePillBrush}"
                                    BorderBrush="{DynamicResource UpdatePillBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="6,0" ToolTip.Tip="{DynamicResource Updates.ReplacedByTip}">
                                <TextBlock Text="{Binding ReplacedLabel}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="note" Text="{Binding DetailLine}" FontFamily="Cascadia Mono, Consolas, Courier New" />
                    </StackPanel>
                    <!-- The active build: one click to the newest build of its own branch -->
                    <Button Grid.Column="1" Classes="accent" VerticalAlignment="Center" IsVisible="{Binding HasUpdate}"
                            Content="{Binding UpdateLabel}" Click="Update_Click" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding CanSwitch}">
                        <Button Classes="tool" Content="{DynamicResource Updates.SwitchTo}" Click="Switch_Click" />
                        <Button Classes="tool" Content="{DynamicResource Common.Remove}" Click="Remove_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto,Auto" Margin="18">
        <ScrollViewer x:Name="Sections" Grid.Row="0">
            <StackPanel Spacing="14" Margin="0,0,6,0">

                <!-- PHP -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PHP" FontSize="16" FontWeight="Bold" />
                        <TextBlock Classes="section" Text="{DynamicResource Updates.INSTALLED}" />
                        <ItemsControl ItemsSource="{Binding PhpVersions}" ItemTemplate="{StaticResource VersionRow}"
                                      IsEnabled="{Binding IsIdle}" />
                        <Button Classes="tool" Content="{DynamicResource Updates.AddExistingFolder}" Click="PhpImport_Click"
                                IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" />

                        <TextBlock Classes="section" Text="{DynamicResource Updates.INSTALLANOTHERVERSION}" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding PhpBranches}" SelectedItem="{Binding SelectedPhp}"
                                  HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" PlaceholderText="{DynamicResource Updates.LoadingBranchesPlaceholder}" />
                        <TextBlock Text="{Binding PhpAvailable}" FontSize="13" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="{DynamicResource Updates.DownloadAndInstall}" Click="PhpLatest_Click" IsEnabled="{Binding IsIdle}" />
                            <Button Classes="tool" Content="{DynamicResource Updates.InstallFromZip}" Click="PhpZip_Click" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <TextBlock Classes="note"
                                   Text="{DynamicResource Updates.PHP8ThreadSafeX64}" />
                    </StackPanel>
                </Border>

                <!-- MariaDB -->
                <Border x:Name="MariaCard" Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MariaDB" FontSize="16" FontWeight="Bold" />
                        <TextBlock Classes="section" Text="{DynamicResource Updates.INSTALLED}" />
                        <ItemsControl ItemsSource="{Binding MariaVersions}" ItemTemplate="{StaticResource VersionRow}"
                                      IsEnabled="{Binding IsIdle}" />
                        <Button Classes="tool" Content="{DynamicResource Updates.AddExistingFolder}" Click="MariaImport_Click"
                                IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" />
                        <TextBlock Classes="note"
                                   Text="{DynamicResource Updates.EachMariaDBVersionKeepsIts}" />

                        <TextBlock Classes="section" Text="{DynamicResource Updates.INSTALLANOTHERVERSION}" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding MariaMajors}" SelectedItem="{Binding SelectedMajor}"
                                  HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" PlaceholderText="{DynamicResource Updates.LoadingReleasesPlaceholder}" />
                        <TextBlock Text="{Binding MariaAvailable}" FontSize="13" TextWrapping="Wrap" />
                        <CheckBox Content="{DynamicResource Updates.BackUpAllDatabasesTo}"
                                  IsChecked="{Binding MakeSqlDump}" IsEnabled="{Binding IsIdle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="{DynamicResource Updates.DownloadAndInstall}" Click="MariaLatest_Click" IsEnabled="{Binding IsIdle}" />
                            <Button Classes="tool" Content="{DynamicResource Updates.InstallFromZip}" Click="MariaZip_Click" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <TextBlock Classes="note"
                                   Text="{DynamicResource Updates.TheNewVersionStartsWith}" />
                    </StackPanel>
                </Border>

                <!-- FileZilla Server -->
                <Border x:Name="FileZillaCard" Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Updates.FileZillaServer}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Classes="section" Text="{DynamicResource Updates.INSTALLED}" />
                        <TextBlock Text="{Binding FileZillaInstalled}" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FileZillaAvailable}" FontSize="13" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="{DynamicResource Updates.OpenDownloadPage}" Click="FileZillaDownload_Click"
                                    IsEnabled="{Binding IsIdle}" />
                            <Button Classes="tool" Content="{DynamicResource Updates.RunDownloadedInstaller}" Click="FileZillaInstall_Click"
                                    IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <TextBlock Classes="note"
                                   Text="{DynamicResource Updates.FileZillaSDownloadLinksExpire}" />
                    </StackPanel>
                </Border>

                <!-- Mailpit -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Updates.MailpitMailCatcher}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Classes="section" Text="{DynamicResource Updates.INSTALLED}" />
                        <TextBlock Text="{Binding MailpitInstalled}" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MailpitAvailable}" FontSize="13" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="{Binding MailpitAction}" Click="MailpitInstall_Click"
                                    IsEnabled="{Binding CanInstallMailpit}" />
                            <Button Classes="tool" Content="{DynamicResource Updates.ProjectPage}" Click="MailpitPage_Click" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <TextBlock Classes="note"
                                   Text="{DynamicResource Updates.CatchesEveryEmailYourPHP}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Progress / result -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
            <ProgressBar IsVisible="{Binding ShowProgress}" IsIndeterminate="{Binding ProgressIndeterminate}"
                         Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" />
            <Button Classes="tool" Content="{Binding RollbackLabel}" IsVisible="{Binding CanRollback}"
                    IsEnabled="{Binding IsIdle}" Click="Rollback_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Classes="tool" Content="{DynamicResource Updates.CheckAgain}" Click="Check_Click" IsEnabled="{Binding IsIdle}" />
            <TextBlock Grid.Column="1" Classes="note" Text="{DynamicResource Updates.DetailsAreWrittenToThe}" VerticalAlignment="Center" Margin="12,0" />
            <Button Grid.Column="2" Classes="tool" Content="{DynamicResource Common.Close}" Width="90" Click="Close_Click" IsEnabled="{Binding IsIdle}" />
        </Grid>
    </Grid>
</Window>
