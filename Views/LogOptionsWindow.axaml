<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XamppControl.Views.LogOptionsWindow"
        Title="Log Options"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="18" Spacing="14">
        <Border Classes="card" Padding="16">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Font size" FontWeight="SemiBold" />
                        <ComboBox x:Name="FontSizeBox" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Lines kept in the window" FontWeight="SemiBold" />
                        <TextBox x:Name="MaxLinesBox" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <CheckBox x:Name="LogToFileBox" Content="Also write the log to a file" />
                    <TextBlock x:Name="LogPathText" Classes="mono" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    <Button Classes="tool" Content="Open log folder" HorizontalAlignment="Left" Click="OpenFolder_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Classes="error" FontSize="12" IsVisible="False" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="tool" Width="90" Height="34" Content="Abort" Click="Abort_Click" />
            <Button Classes="tool" Width="90" Height="34" Content="Save" FontWeight="SemiBold" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
