<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XamppControl.Views.CrashWindow"
        Title="Something went wrong"
        Width="640" Height="480" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">

        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
            <TextBlock Text="The Control Panel hit an error it couldn't recover from." FontSize="16" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap">
                Your servers keep running; only the panel is affected. The details below were also saved to
                crash.log in the settings folder. Please open an issue and paste them in.
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Padding="12">
            <ScrollViewer>
                <SelectableTextBlock x:Name="DetailsText" Classes="mono" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,8,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Classes="tool" Content="Copy details" Click="Copy_Click" />
            <Button Grid.Column="1" Classes="tool" Content="Open an issue" Click="Issue_Click" Margin="8,0,0,0" />
            <Button Grid.Column="3" Classes="tool" Content="Keep running" Width="110" Click="Continue_Click" />
            <Button Grid.Column="5" Classes="accent" Content="Quit" Width="90" Click="Quit_Click" />
        </Grid>
    </Grid>
</Window>
