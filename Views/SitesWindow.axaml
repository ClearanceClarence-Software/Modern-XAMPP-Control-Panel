<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        x:Class="XamppControl.Views.SitesWindow"
        x:DataType="vm:SitesViewModel"
        Title="{DynamicResource Sites.Title}"
        Width="960" Height="600" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="18">

        <!-- Intro -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Sites.GiveEachProjectItsOwn}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="note" Text="{Binding LocalhostNote}" />
        </StackPanel>

        <!-- Sites -->
        <Border Grid.Row="1" Classes="card">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="34" Padding="12,0" Background="{DynamicResource HeaderBrush}" CornerRadius="8,8,0,0"
                        BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="200,10,*,10,70,10,286">
                        <TextBlock Grid.Column="0" Classes="colhead" Text="{DynamicResource Sites.HOSTNAME}" />
                        <TextBlock Grid.Column="2" Classes="colhead" Text="{DynamicResource Sites.FOLDER}" />
                        <TextBlock Grid.Column="4" Classes="colhead" Text="HTTPS" />
                    </Grid>
                </Border>

                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="12,8">
                    <Button Grid.Column="0" Classes="tool" Content="{DynamicResource Sites.AddSite}" Command="{Binding AddCommand}" />
                    <TextBlock Grid.Column="1" Classes="note" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="{DynamicResource Sites.UseNamesEndingInTest}" />
                </Grid>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding IsIdle}" Margin="0,0,10,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SiteRow">
                                <Border Padding="12,8" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="200,10,*,10,70,10,286">
                                        <TextBox Grid.Column="0" Text="{Binding Host}" PlaceholderText="{DynamicResource Sites.MyprojectTestPlaceholder}" />
                                        <Grid Grid.Column="2" ColumnDefinitions="*,6,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Folder}"
                                                     PlaceholderText="{DynamicResource Sites.CXamppHtdocsMyprojectPlaceholder}" />
                                            <Button Grid.Column="2" Classes="tool" Content="{DynamicResource Common.Browse}" Click="Browse_Click" />
                                        </Grid>
                                        <CheckBox Grid.Column="4" IsChecked="{Binding UseHttps}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="tool" Content="{DynamicResource Common.Open}" Command="{Binding OpenCommand}"
                                                    ToolTip.Tip="{Binding Url}" />
                                            <Button Classes="tool" Content="{DynamicResource Common.Editor}" Command="{Binding EditorCommand}"
                                                    ToolTip.Tip="{DynamicResource Sites.OpenTheFolderInTheTip}" />
                                            <Button Classes="tool" Content="{DynamicResource Sites.Terminal}" Command="{Binding TerminalCommand}"
                                                    ToolTip.Tip="{DynamicResource Sites.CommandPromptInTheFolderTip}" />
                                            <Button Classes="tool" Content="{DynamicResource Common.Remove}" Click="Remove_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Certificate -->
        <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TrustStatus}" TextWrapping="Wrap" />
                    <TextBlock Classes="note"
                               Text="{DynamicResource Sites.FirefoxKeepsItsOwnList}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="tool" Content="{DynamicResource Sites.Trust}" Click="Trust_Click"
                        IsVisible="{Binding CanTrust}" IsEnabled="{Binding IsIdle}" />
                <Button Grid.Column="3" Classes="tool" Content="{DynamicResource Sites.ShowLocalCaCrt}" Click="ShowAuthority_Click" />
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />

        <!-- Apply / Close -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,8,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Classes="note" VerticalAlignment="Center"
                       Text="{DynamicResource Sites.ApplyWritesHttpdVhostsConf}" />
            <Button Grid.Column="1" Classes="accent" Content="{DynamicResource Sites.Apply}" Width="100" Click="Apply_Click"
                    IsEnabled="{Binding IsIdle}" />
            <Button Grid.Column="3" Classes="tool" Content="{DynamicResource Common.Close}" Width="90" Click="Close_Click"
                    IsEnabled="{Binding IsIdle}" />
        </Grid>
    </Grid>
</Window>
