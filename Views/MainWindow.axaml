<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        xmlns:v="using:XamppControl.Views"
        x:Class="XamppControl.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{DynamicResource Main.Title}"
        Width="1040" Height="800"
        MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Config/Logs menus: each generated MenuItem binds to a FileLink.
             Scoped to MenuFlyoutPresenter so the log's context menu is unaffected. -->
        <Style Selector="MenuFlyoutPresenter > MenuItem" x:DataType="vm:FileLink">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="Command" Value="{Binding OpenCommand}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="20,16,20,20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                <!-- The app icon from Assets\app.png when present; otherwise the fallback glyph -->
                <Image x:Name="HeaderLogo" Width="44" Height="44" IsVisible="False"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <Border x:Name="HeaderFallback" Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                    <v:Glyph Data="{StaticResource IconStack}" Tint="{StaticResource IconStackTint}"
                             Width="24" Height="24" Foreground="White" Accent="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{DynamicResource Main.ModernXAMPPControlPanel}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding Version}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        <Button Content="{Binding AppUpdateText}" Click="AppUpdate_Click"
                                IsVisible="{Binding HasAppUpdate}" VerticalAlignment="Bottom"
                                Padding="8,1" FontSize="11" MinHeight="0" CornerRadius="10"
                                Background="{DynamicResource UpdatePillBrush}" BorderBrush="{DynamicResource UpdatePillBorderBrush}"
                                BorderThickness="1" Foreground="{DynamicResource LinkBrush}"
                                ToolTip.Tip="{DynamicResource Main.SeeWhatSNewAndTip}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Main.Change}" Click="ChangeRoot_Click" Padding="6,1" FontSize="11" MinHeight="0"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource LinkBrush}"
                                ToolTip.Tip="{DynamicResource Main.ChooseTheXAMPPInstallationFolderTip}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- About and the light/dark switch: the moon shows in the light theme, the sun in the dark one -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="ghost" Width="36" Height="36" Click="About_Click" ToolTip.Tip="{DynamicResource Main.AboutThisPanelTip}">
                    <v:Glyph Width="18" Height="18" Data="{StaticResource IconInfo}" Tint="{StaticResource IconInfoTint}" />
                </Button>
                <Button x:Name="ThemeToggle" Classes="ghost" Width="36" Height="36" Click="ThemeToggle_Click">
                    <v:Glyph x:Name="ThemeIcon" Width="18" Height="18" Data="{StaticResource IconMoon}" Tint="{StaticResource IconMoonTint}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Modules + side buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,14,132">

            <!-- The rows share the card's height evenly, so the card ends level with the last side button. -->
            <Border Grid.Column="0" Classes="card">
                <DockPanel>
                    <!-- Column headers -->
                    <Border DockPanel.Dock="Top" Height="34" Padding="14,0" Background="{DynamicResource HeaderBrush}"
                            CornerRadius="8,8,0,0" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="58,176,64,92,*">
                            <TextBlock Grid.Column="0" Classes="colhead" Text="{DynamicResource Main.SERVICE}" />
                            <TextBlock Grid.Column="1" Classes="colhead" Text="{DynamicResource Main.MODULE}" />
                            <TextBlock Grid.Column="2" Classes="colhead" Text="{DynamicResource Main.PIDS}" />
                            <TextBlock Grid.Column="3" Classes="colhead" Text="{DynamicResource Main.PORTS}" />
                            <TextBlock Grid.Column="4" Classes="colhead" Text="{DynamicResource Common.ACTIONS}" />
                            <!-- Start all: the Autostart modules, or Apache and MySQL. Stop all: everything that runs. -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" IsVisible="{Binding HasXampp}">
                                <Button Classes="textlink" Content="{DynamicResource Main.StartAll}" Click="StartAll_Click"
                                        ToolTip.Tip="{DynamicResource Main.StartAllTip}" />
                                <Button Classes="textlink" Content="{DynamicResource Main.StopAll}" Click="StopAll_Click"
                                        ToolTip.Tip="{DynamicResource Main.StopAllTip}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Shown under the headers until a XAMPP folder is chosen -->
                    <Border DockPanel.Dock="Top" Padding="14,10" IsVisible="{Binding !HasXampp}"
                            Background="{DynamicResource UpdatePillBrush}" BorderBrush="{DynamicResource UpdatePillBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,8,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Main.NoXAMPPInstallationFound}" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding MissingXamppText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="tool" Content="{DynamicResource Common.DownloadXAMPP}" Click="DownloadXampp_Click" />
                            <Button Grid.Column="3" Classes="accent" Content="{DynamicResource Common.ChooseFolder}" Click="ChangeRoot_Click" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Modules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleViewModel">
                                <Border MinHeight="52" Padding="14,0" Opacity="{Binding RowOpacity}"
                                        BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="58,176,64,92,*">

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsServiceInstalled, Mode=OneWay}"
                                                  IsEnabled="{Binding CanUseService}"
                                                  Command="{Binding ToggleServiceCommand}"
                                                  ToolTip.Tip="{Binding ServiceTip}" ToolTip.ShowOnDisabled="True" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse Classes="dot"
                                                     Classes.running="{Binding IsRunning}"
                                                     Classes.busy="{Binding IsBusy}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                    <!-- A newer build of the row's component, found by the startup check -->
                                                    <Button Classes="textlink" Content="{Binding UpdateHint}"
                                                            IsVisible="{Binding HasUpdateHint}" Click="UpdateHint_Click"
                                                            ToolTip.Tip="{Binding UpdateTip}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Pids}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource CellTextBrush}" />
                                        <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Ports}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource CellTextBrush}" TextWrapping="Wrap" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="tool"
                                                    Classes.start="{Binding ShowStart}"
                                                    Classes.stop="{Binding ShowStop}"
                                                    Content="{Binding ActionLabel}"
                                                    Command="{Binding ActionCommand}" />
                                            <Button Classes="tool" Content="{DynamicResource Main.Admin}" Command="{Binding AdminCommand}" />

                                            <Button Classes="tool" Content="{DynamicResource Main.Config}" IsEnabled="{Binding HasConfig}">
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding ConfigFiles}" />
                                                </Button.Flyout>
                                            </Button>

                                            <Button Classes="tool" Content="{DynamicResource Main.Logs}" IsEnabled="{Binding HasLogs}">
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding LogFiles}" />
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Side buttons: one column with even spacing; Quit is last, like the original panel -->
            <StackPanel Grid.Column="2" Spacing="6">
                <Button Classes="side" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconGear}" Tint="{StaticResource IconGearTint}" />
                        <TextBlock Text="{DynamicResource Main.Config}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Click="Netstat_Click">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconGlobe}" Tint="{StaticResource IconGlobeTint}" />
                        <TextBlock Text="{DynamicResource Main.Netstat}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Click="Updates_Click" ToolTip.Tip="{Binding ComponentUpdateTip}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconUpdate}" Tint="{StaticResource IconUpdateTint}" />
                        <TextBlock Text="{DynamicResource Common.Versions}" VerticalAlignment="Center" />
                        <!-- How many of PHP, MariaDB and Mailpit have a newer build -->
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="18" Height="18"
                                Padding="5,0" VerticalAlignment="Center" IsVisible="{Binding HasVersionUpdates}">
                            <TextBlock Text="{Binding ComponentUpdateCount}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Classes="side" Click="Databases_Click">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconDatabase}" Tint="{StaticResource IconDatabaseTint}" />
                        <TextBlock Text="{DynamicResource Common.Databases}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Click="Logs_Click">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconLogs}" Tint="{StaticResource IconLogsTint}" />
                        <TextBlock Text="{DynamicResource Main.Logs}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Click="Sites_Click">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconSites}" Tint="{StaticResource IconSitesTint}" />
                        <TextBlock Text="{DynamicResource Main.Sites}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Click="PhpSettings_Click" ToolTip.Tip="{Binding XdebugUpdateTip}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconCode}" />
                        <TextBlock Text="PHP" VerticalAlignment="Center" />
                        <!-- A newer Xdebug for the active PHP; it is installed in the PHP window -->
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="18" Height="18"
                                Padding="5,0" VerticalAlignment="Center" IsVisible="{Binding HasXdebugUpdate}">
                            <TextBlock Text="1" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Classes="side" Command="{Binding ShellCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconShell}" Tint="{StaticResource IconShellTint}" />
                        <TextBlock Text="{DynamicResource Main.Shell}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Command="{Binding ExplorerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconFolder}" Tint="{StaticResource IconFolderTint}" />
                        <TextBlock Text="{DynamicResource Main.Explorer}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Command="{Binding ServicesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconServices}" Tint="{StaticResource IconServicesTint}" />
                        <TextBlock Text="{DynamicResource Main.Services}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Command="{Binding HelpCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconHelp}" Tint="{StaticResource IconHelpTint}" />
                        <TextBlock Text="{DynamicResource Main.Help}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="side" Click="Quit_Click">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <v:Glyph Data="{StaticResource IconQuit}" Tint="{StaticResource IconQuitTint}" />
                        <TextBlock Text="{DynamicResource Common.Quit}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="2" Classes="card" Margin="0,14,0,0">
            <ListBox x:Name="LogList" Classes="log" ItemsSource="{Binding Log}" FontSize="{Binding LogFontSize}"
                     Background="Transparent" Padding="0,6" SelectionMode="Multiple">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Common.CopySelected}" Click="CopySelected_Click" />
                        <MenuItem Header="{DynamicResource Main.CopyAll}" Click="CopyAll_Click" />
                        <Separator />
                        <MenuItem Header="{DynamicResource Main.Clear}" Command="{Binding ClearLogCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntry">
                        <Grid ColumnDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Column="0" Classes="logtext" Text="{Binding Time}" Foreground="{DynamicResource LogTimeBrush}" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="1" Classes="logtext source" Text="{Binding Source}"
                                       Classes.apache="{Binding IsApache}" Classes.mysql="{Binding IsMySql}"
                                       Classes.filezilla="{Binding IsFileZilla}" Classes.mercury="{Binding IsMercury}"
                                       Classes.tomcat="{Binding IsTomcat}" Classes.update="{Binding IsUpdate}"
                                       Classes.sites="{Binding IsSites}" Classes.php="{Binding IsPhp}"
                                       MinWidth="90" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="2" Classes="logtext" Text="{Binding Message}"
                                       Classes.error="{Binding IsError}" Classes.warn="{Binding IsWarn}"
                                       Classes.ok="{Binding IsOk}" Classes.debug="{Binding IsDebug}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
