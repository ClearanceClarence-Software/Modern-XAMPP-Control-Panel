<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        x:Class="XamppControl.Views.LogViewerWindow"
        x:DataType="vm:LogViewerViewModel"
        Title="{DynamicResource LogViewer.Title}"
        Width="1040" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- The log lines: rows that reach the edges, so an error's tint and red bar fill the row -->
        <Style Selector="ListBox.lines">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.lines ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="ListBox.lines ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="ListBox.lines ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UpdatePillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="ListBox.lines ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UpdatePillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style Selector="Border.line.error">
            <Setter Property="Background" Value="{DynamicResource StopBgBrush}" />
        </Style>
        <!-- A selected error gives up its tint, or the selection wouldn't show on it -->
        <Style Selector="ListBox.lines ListBoxItem:selected Border.line.error">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.message.quiet">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <!-- The level label: gray, amber for a warning, red for an error -->
        <Style Selector="Border.level">
            <Setter Property="Width" Value="54" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Border.level TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Border.level.warn">
            <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
        </Style>
        <Style Selector="Border.level.warn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
        </Style>
        <Style Selector="Border.level.error">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="Border.level.error TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- A log file's problem count: amber for warnings, red for errors -->
        <Style Selector="Border.count">
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
        </Style>
        <Style Selector="Border.count TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
        </Style>
        <Style Selector="Border.count.error">
            <Setter Property="Background" Value="{DynamicResource StopBgBrush}" />
        </Style>
        <Style Selector="Border.count.error TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StopFgBrush}" />
        </Style>

        <!-- A bar of the timeline: the whole column is the click target, the bar sits on its floor -->
        <Style Selector="Button.slice">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="1,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
        </Style>
        <Style Selector="Button.slice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="CornerRadius" Value="2,2,0,0" />
            <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
        </Style>
        <Style Selector="Border.bar.warn">
            <Setter Property="Background" Value="{DynamicResource DotBusyBrush}" />
        </Style>
        <Style Selector="Border.bar.error">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="210,12,*" Margin="16">

        <!-- The log files -->
        <Border Grid.Row="0" Grid.Column="0" Classes="card" ClipToBounds="True">
            <ListBox Classes="rows" ItemsSource="{Binding Sources}" SelectedItem="{Binding Selected}" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogSource">
                        <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                            <Grid ColumnDefinitions="3,11,Auto,10,*,8,Auto,12" MinHeight="50">
                                <!-- The accent bar of the chosen file -->
                                <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                                <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1" ClipToBounds="True">
                                    <TextBlock Text="{Binding Label}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource FaintBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="6" Classes="count" Classes.error="{Binding HasErrors}"
                                        IsVisible="{Binding HasProblems}" ToolTip.Tip="{DynamicResource LogViewer.CountTip}">
                                    <TextBlock Text="{Binding CountText}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="0" Grid.Column="2" RowDefinitions="Auto,*">

            <!-- Filter, level, follow -->
            <Grid Grid.Row="0" ColumnDefinitions="*,10,Auto,10,Auto,10,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0" Text="{Binding Filter}" Height="34" VerticalContentAlignment="Center"
                         PlaceholderText="{DynamicResource LogViewer.FilterLinesEGErrorPlaceholder}" />
                <Border Grid.Column="2" Background="{DynamicResource ControlHoverBrush}" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="seg" Classes.on="{Binding IsAllLevels}" Content="{DynamicResource LogViewer.All}"
                                Click="AllLevels_Click" />
                        <Button Classes="seg" Classes.on="{Binding IsProblemsOnly}" Content="{Binding ProblemsLabel}"
                                Click="ProblemsOnly_Click" ToolTip.Tip="{DynamicResource LogViewer.ProblemsTip}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource ControlHoverBrush}" CornerRadius="8" Padding="3">
                    <Button Classes="seg" Classes.on="{Binding IsFollowing}" Content="{DynamicResource LogViewer.Follow}"
                            Click="Follow_Click" ToolTip.Tip="{DynamicResource LogViewer.FollowTip}" />
                </Border>
                <Button Grid.Column="6" Classes="tool" Height="34" Content="{DynamicResource LogViewer.ClearView}"
                        Command="{Binding ClearCommand}" />
            </Grid>

            <Border Grid.Row="1" Classes="card" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">

                    <!-- When the lines were written; a click on a bar jumps there -->
                    <Border Grid.Row="0" IsVisible="{Binding HasTimeline}" BorderBrush="{DynamicResource RowLineBrush}"
                            BorderThickness="0,0,0,1" Padding="12,8,12,6">
                        <StackPanel Spacing="3">
                            <ItemsControl ItemsSource="{Binding Buckets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogBucket">
                                        <Button Classes="slice" Click="Bucket_Click" ToolTip.Tip="{Binding Tip}">
                                            <Border Classes="bar" Classes.warn="{Binding IsWarn}" Classes.error="{Binding IsError}"
                                                    Height="{Binding Height}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto,*">
                                <TextBlock Grid.Column="0" Text="{Binding AxisStart}" FontSize="10.5"
                                           Foreground="{DynamicResource FaintBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding AxisMiddle}" FontSize="10.5"
                                           Foreground="{DynamicResource FaintBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding AxisEnd}" FontSize="10.5" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource FaintBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Panel Grid.Row="1">
                        <ListBox x:Name="LinesList" Classes="lines" ItemsSource="{Binding Lines}" SelectionMode="Multiple">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Common.CopySelected}" Click="CopySelected_Click" />
                                    <MenuItem Header="{DynamicResource LogViewer.CopyAllShown}" Click="CopyAll_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogLine">
                                    <!-- The tooltip is the line as written, with the code and process the list leaves out -->
                                    <Border Classes="line" Classes.error="{Binding IsError}" BorderBrush="{DynamicResource RowLineBrush}"
                                            BorderThickness="0,0,0,1" ToolTip.Tip="{Binding Text}">
                                        <Grid ColumnDefinitions="3,11,108,Auto,12,*,14">
                                            <Border Grid.Column="0" Background="{DynamicResource ErrorBrush}" IsVisible="{Binding IsError}" />
                                            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding TimeText}" FontSize="12"
                                                       Foreground="{DynamicResource LogTimeBrush}" Margin="0,7,0,7" />
                                            <!-- The column keeps its width without a label, so the messages line up -->
                                            <Panel Grid.Column="3" Width="54" Margin="0,7,0,0">
                                                <Border Classes="level" Classes.warn="{Binding IsWarn}" Classes.error="{Binding IsError}"
                                                        IsVisible="{Binding HasLevel}">
                                                    <TextBlock Text="{Binding LevelText}" />
                                                </Border>
                                            </Panel>
                                            <TextBlock Grid.Column="5" Classes="mono message" Classes.quiet="{Binding IsQuiet}"
                                                       Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,7" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding HasEmptyText}" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="32" />
                    </Panel>
                </Grid>
            </Border>
        </Grid>

        <!-- The file being followed, and how much of it shows -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,16,Auto" Margin="2,10,0,0">
            <TextBlock Grid.Column="0" Classes="muted" FontSize="12" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding Summary}" />
        </Grid>
    </Grid>
</Window>
