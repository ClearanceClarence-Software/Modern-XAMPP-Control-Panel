<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        x:Class="XamppControl.Views.PhpSettingsWindow"
        x:DataType="vm:PhpSettingsViewModel"
        Title="PHP settings"
        Width="960" Height="680" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18">

        <TextBlock Grid.Row="0" Classes="note" Text="{Binding Title}" Margin="0,0,0,12" />

        <Grid Grid.Row="1" ColumnDefinitions="*,14,*" IsEnabled="{Binding IsIdle}">

            <!-- Common values -->
            <Border Grid.Column="0" Classes="card" Padding="16,12" IsEnabled="{Binding HasIni}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <!-- Right margin keeps the boxes clear of the scroll bar -->
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Settings}" Margin="0,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PhpSettingRow">
                                    <Border Padding="0,10" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,14,130">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <TextBlock Classes="mono" Text="{Binding Key}" FontSize="11"
                                                               Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Classes="note" Text="{Binding Hint}" />
                                            </StackPanel>
                                            <TextBox Grid.Column="2" Text="{Binding Value}" Watermark="not set"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Extensions -->
            <Border Grid.Column="2" Classes="card" Padding="16,12" IsEnabled="{Binding HasIni}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Extensions" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Classes="note" Margin="0,0,0,8"
                               Text="Every extension DLL in php\ext. Checked ones load with Apache." />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Extensions}" Margin="0,0,14,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="150" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PhpExtensionRow">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Classes="tool" Content="Open php.ini" Click="OpenIni_Click" IsEnabled="{Binding HasIni}" />
            <TextBlock Grid.Column="1" Classes="note" VerticalAlignment="Center" Margin="12,0"
                       Text="Saving keeps the previous file as php.ini.bak and restarts Apache when it runs." />
            <Button Grid.Column="2" Classes="accent" Content="Save" Width="100" Click="Save_Click"
                    IsEnabled="{Binding CanSave}" />
            <Button Grid.Column="4" Classes="tool" Content="Close" Width="90" Click="Close_Click"
                    IsEnabled="{Binding IsIdle}" />
        </Grid>
    </Grid>
</Window>
