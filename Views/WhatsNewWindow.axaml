<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        x:Class="XamppControl.Views.WhatsNewWindow"
        x:DataType="vm:MainViewModel"
        Title="What's new"
        Width="640" Height="600" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding AppUpdateText}" FontSize="18" FontWeight="Bold" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding AppUpdateSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Padding="16,12">
            <ScrollViewer>
                <SelectableTextBlock Text="{Binding AppUpdateNotes}" TextWrapping="Wrap" LineHeight="21"
                                     Margin="0,0,10,0" />
            </ScrollViewer>
        </Border>

        <!-- Progress while the update downloads -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasAppUpdateStatus}">
            <ProgressBar Height="6" IsVisible="{Binding IsInstallingAppUpdate}" Minimum="0" Maximum="100" Value="{Binding AppUpdateProgress}"
                         IsIndeterminate="{Binding IsAppUpdateProgressIndeterminate}" />
            <TextBlock Text="{Binding AppUpdateStatus}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,8,Auto,8,Auto" Margin="0,14,0,0">
            <TextBlock Grid.Column="0" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,12,0" Text="{Binding AppUpdateHint}" />
            <Button Grid.Column="1" Classes="accent" Content="Install and restart" Click="Install_Click"
                    IsEnabled="{Binding CanInstallAppUpdate}" />
            <Button Grid.Column="3" Classes="tool" Content="Release page" Click="Download_Click"
                    IsEnabled="{Binding !IsInstallingAppUpdate}" />
            <Button Grid.Column="5" Classes="tool" Content="Later" Width="80" Click="Close_Click"
                    IsEnabled="{Binding !IsInstallingAppUpdate}" />
        </Grid>
    </Grid>
</Window>
