<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XamppControl.Views.XamppMissingWindow"
        Title="{DynamicResource XamppMissing.Title}"
        Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Image x:Name="Logo" Width="40" Height="40" VerticalAlignment="Top" />
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource XamppMissing.XAMPPWasnTFound}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{DynamicResource XamppMissing.ThisPanelControlsAnExisting}" />
            </StackPanel>
        </StackPanel>

        <Border Classes="card" Padding="12,8">
            <ItemsControl x:Name="FolderList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="mono" Text="{Binding}" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="{DynamicResource XamppMissing.IfXAMPPIsInstalledSomewhere}" />

        <Grid ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="0" Classes="tool" Content="{DynamicResource Common.DownloadXAMPP}" Click="Download_Click" />
            <Button Grid.Column="2" Classes="tool" Content="{DynamicResource XamppMissing.ContinueWithout}" MinWidth="110" Click="Continue_Click" />
            <Button Grid.Column="4" Classes="accent" Content="{DynamicResource Common.ChooseFolder}" MinWidth="120" Click="Choose_Click" />
        </Grid>
    </StackPanel>
</Window>
