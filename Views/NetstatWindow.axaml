<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamppControl.ViewModels"
        x:Class="XamppControl.Views.NetstatWindow"
        x:DataType="vm:NetstatViewModel"
        Title="{DynamicResource Netstat.Title}"
        Width="980" Height="660"
        MinWidth="780" MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- A port: neutral, XAMPP's in the accent color, a blocked one in red -->
        <Style Selector="Border.port">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.port TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.port.xampp">
            <Setter Property="Background" Value="{DynamicResource UpdatePillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UpdatePillBorderBrush}" />
        </Style>
        <Style Selector="Border.port.xampp TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        </Style>
        <Style Selector="Border.port.blocked">
            <Setter Property="Background" Value="{DynamicResource StopBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StopBorderBrush}" />
        </Style>
        <Style Selector="Border.port.blocked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StopFgBrush}" />
        </Style>

        <!-- Netstat's own labels: new, blocking -->
        <Style Selector="Border.tag.fresh">
            <Setter Property="Background" Value="{DynamicResource NetstatNewBrush}" />
        </Style>
        <Style Selector="Border.tag.fresh TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NetstatNewTextBrush}" />
        </Style>
        <Style Selector="Border.tag.blocking">
            <Setter Property="Background" Value="{DynamicResource StopBgBrush}" />
        </Style>
        <Style Selector="Border.tag.blocking TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StopFgBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Search, scope, and the Windows toggle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,10,Auto,10,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" Text="{Binding Filter}" Height="34" VerticalContentAlignment="Center"
                     PlaceholderText="{DynamicResource Netstat.SearchPlaceholder}" />
            <Border Grid.Column="2" Background="{DynamicResource ControlHoverBrush}" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="seg" Classes.on="{Binding IsScopeAll}" Content="{DynamicResource Netstat.ScopeAll}"
                            Click="ScopeAll_Click" />
                    <Button Classes="seg" Classes.on="{Binding IsScopeXampp}" Content="XAMPP" Click="ScopeXampp_Click" />
                    <Button Classes="seg" Classes.on="{Binding IsScopeBlocking}" Content="{DynamicResource Netstat.ScopeBlocking}"
                            Click="ScopeBlocking_Click" ToolTip.Tip="{DynamicResource Netstat.ScopeBlockingTip}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="{DynamicResource ControlHoverBrush}" CornerRadius="8" Padding="3">
                <Button Classes="seg" Classes.on="{Binding ShowSystem}" Content="{Binding SystemLabel}" Click="System_Click"
                        ToolTip.Tip="{DynamicResource Netstat.WindowsTip}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,12,310">

            <!-- The programs -->
            <Border Grid.Column="0" Classes="card" ClipToBounds="True">
                <Panel>
                    <ListBox Classes="rows" ItemsSource="{Binding Programs}" SelectedItem="{Binding Selected}"
                             SelectionMode="Single" AutoScrollToSelectedItem="False" DoubleTapped="Programs_DoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NetstatProgram">
                                <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1"
                                        Opacity="{Binding RowOpacity}" Background="Transparent">
                                    <Grid ColumnDefinitions="3,11,Auto,12,*,10,Auto,14" MinHeight="54">
                                        <!-- The accent bar of the chosen entry -->
                                        <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />

                                        <Border Grid.Column="2" Width="34" Height="34" CornerRadius="9"
                                                Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1" ClipToBounds="True">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Classes="tag blocking" IsVisible="{Binding IsBlocking}">
                                                    <TextBlock Text="{Binding BlockingText}" />
                                                </Border>
                                                <Border Classes="tag fresh" IsVisible="{Binding IsNew}">
                                                    <TextBlock Text="{DynamicResource Netstat.TagNew}" />
                                                </Border>
                                                <Border Classes="tag" IsVisible="{Binding IsOld}">
                                                    <TextBlock Text="{DynamicResource Netstat.TagClosed}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>

                                        <ItemsControl Grid.Column="6" ItemsSource="{Binding PortChips}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PortChip">
                                                    <Border Classes="port" Classes.xampp="{Binding IsXampp}" Classes.blocked="{Binding IsBlocking}">
                                                        <TextBlock Text="{Binding Text}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource Netstat.NothingMatches}" IsVisible="{Binding IsEmpty}"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </Border>

            <!-- The chosen program -->
            <Border Grid.Column="2" Classes="card">
                <Panel>
                    <TextBlock Text="{DynamicResource Netstat.SelectAProgram}" IsVisible="{Binding !HasSelection}"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
                    <ScrollViewer IsVisible="{Binding HasSelection}" VerticalScrollBarVisibility="Auto">
                        <!-- A content control with a template, so the pane's bindings are checked against the program -->
                        <ContentControl Content="{Binding Selected}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:NetstatProgram">
                        <StackPanel Margin="18" Spacing="0">
                            <Border Width="44" Height="44" CornerRadius="11" Background="{Binding BadgeBrush}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Initial}" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding ExeLine}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />

                            <!-- Why this program matters right now -->
                            <Border IsVisible="{Binding IsBlocking}" Background="{DynamicResource StopBgBrush}"
                                    BorderBrush="{DynamicResource StopBorderBrush}" BorderThickness="1" CornerRadius="8"
                                    Padding="12,9" Margin="0,14,0,0">
                                <TextBlock Text="{Binding BlockingExplain}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource StopFgBrush}" />
                            </Border>

                            <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,16,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="PID" />
                                <SelectableTextBlock Grid.Row="0" Grid.Column="1" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" Text="{Binding Pid}" Margin="0,2,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="{DynamicResource Netstat.FieldPath}"
                                           IsVisible="{Binding HasPath}" />
                                <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Mono, Consolas, Courier New" Text="{Binding PathText}" FontSize="11"
                                                     TextWrapping="Wrap" Margin="0,3,0,8" IsVisible="{Binding HasPath}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="{DynamicResource Netstat.FieldPorts}" />
                                <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AllPorts}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PortChip">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                                                <Border Classes="port" Classes.xampp="{Binding IsXampp}" Classes.blocked="{Binding IsBlocking}">
                                                    <TextBlock Text="{Binding Text}" />
                                                </Border>
                                                <TextBlock Text="{Binding Service}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding HasService}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="{DynamicResource Netstat.FieldAddresses}" />
                                <SelectableTextBlock Grid.Row="3" Grid.Column="1" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" Text="{Binding Addresses}"
                                                     TextWrapping="Wrap" Margin="0,2,0,8" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="{DynamicResource Netstat.FieldReach}" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="3" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ReachText}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ReachExplain}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="8" Margin="0,22,0,0">
                                <Button Classes="accent wide" Content="{Binding OpenLabel}" Click="Open_Click"
                                        IsVisible="{Binding HasUrl}" />
                                <Button Classes="accent wide" Content="{DynamicResource Netstat.OpenPhpMyAdmin}"
                                        Click="PhpMyAdmin_Click" IsVisible="{Binding IsDatabaseServer}" />
                                <Button Classes="tool wide" Content="{DynamicResource Netstat.ShowInFolder}" Click="Folder_Click"
                                        IsVisible="{Binding HasPath}" />
                                <Button Classes="tool wide" Content="{DynamicResource Netstat.CopyDetails}" Click="Copy_Click" />
                                <Button Classes="tool wide end" Content="{DynamicResource Netstat.EndProcess}" Click="End_Click"
                                        IsVisible="{Binding CanEnd}" ToolTip.Tip="{DynamicResource Netstat.EndThisProgramAndFreeTip}" />
                            </StackPanel>
                        </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>

        <!-- What the last action did, and what is listed -->
        <Grid Grid.Row="2" ColumnDefinitions="*,16,Auto" Margin="2,10,0,0">
            <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
        </Grid>
    </Grid>
</Window>
